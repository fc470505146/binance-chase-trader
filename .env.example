# Binance API
BINANCE_API_KEY=your_api_key_here
BINANCE_SECRET_KEY=your_secret_key_here

# 运行环境：dry-run / testnet / live
# 默认 dry-run 不会真实下单。
CHASER_ENV=dry-run

# 本地控制端口（可选，默认 127.0.0.1:8765）
# BINANCE_DAEMON_HOST=127.0.0.1
# BINANCE_DAEMON_PORT=8765

# 订阅交易对
# CHASER_SYMBOLS=XAGUSDT,XAUUSDT

# 本地状态文件目录。默认 ~/.binance-chase-trader/state/
# CHASER_STATE_DIR=C:\Users\your_name\.binance-chase-trader\state

# 窗口保留最近 60 秒，最多 1000 条 tick
# CHASER_WINDOW_SECONDS=60
# CHASER_WINDOW_MAX_TICKS=1000

# 单订单最小重挂间隔
# CHASER_REPLACE_MIN_INTERVAL_MS=1000

# 使用 Binance 官方订单限频的预算比例
# CHASER_ORDER_BUDGET_RATIO=0.2

# TP/SL 与当前 markPrice 的最大允许偏离比例，默认 0.5 = 50%
# CHASER_PROTECTION_MAX_DISTANCE_PCT=0.5
